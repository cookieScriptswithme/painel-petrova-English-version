local btnSpeedGlitch = createButton("Speed Glitch")
local glitchEnabled = false
local speedGui = nil

btnSpeedGlitch.MouseButton1Click:Connect(function()
    glitchEnabled = not glitchEnabled
    btnSpeedGlitch.Text = glitchEnabled and "Speed Glitch: Enabled" or "Speed Glitch: Disabled"
    btnSpeedGlitch.BackgroundColor3 = glitchEnabled and ENABLED or DISABLED

    if glitchEnabled then
        local function getHumanoid()
            local character = player.Character or player.CharacterAdded:Wait()
            return character:WaitForChild("Humanoid")
        end
        local humanoid = getHumanoid()
        local baseWalkSpeed = humanoid.WalkSpeed
        local speedBoost = 350
        local systemActive = false

        speedGui = Instance.new("ScreenGui")
        speedGui.Name = "SpeedGlitchGui"
        speedGui.ResetOnSpawn = false
        speedGui.Parent = playerGui

        local toggleButton = Instance.new("TextButton")
        toggleButton.Size = UDim2.new(0, 140, 0, 50)
        toggleButton.Position = UDim2.new(0.05, 0, 0.1, 0)
        toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        toggleButton.Text = "System: OFF"
        toggleButton.Font = Enum.Font.GothamBold
        toggleButton.TextSize = 14
        toggleButton.Parent = speedGui
        Instance.new("UICorner", toggleButton).CornerRadius = UDim.new(0, 8)
        toggleButton.Active = true
        toggleButton.Draggable = true

        local function updateButton()
            if systemActive then
                toggleButton.Text = "System: ON"
                toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            else
                toggleButton.Text = "System: OFF"
                toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            end
        end

        toggleButton.MouseButton1Click:Connect(function()
            systemActive = not systemActive
            updateButton()
            if not systemActive then
                pcall(function() humanoid.WalkSpeed = baseWalkSpeed end)
            end
        end)

        local function connectHumanoid(hum)
            hum.StateChanged:Connect(function(_, newState)
                if systemActive then
                    if newState == Enum.HumanoidStateType.Jumping then
                        hum.WalkSpeed = baseWalkSpeed + speedBoost
                    elseif newState == Enum.HumanoidStateType.Landed then
                        hum.WalkSpeed = baseWalkSpeed
                    end
                end
            end)
        end

        connectHumanoid(humanoid)

        player.CharacterAdded:Connect(function(char)
            humanoid = char:WaitForChild("Humanoid")
            baseWalkSpeed = humanoid.WalkSpeed
            connectHumanoid(humanoid)
            if not systemActive then
                humanoid.WalkSpeed = baseWalkSpeed
            end
        end)

        updateButton()
    else
        if speedGui then speedGui:Destroy() speedGui = nil end
    end
end)

